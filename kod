          <div class="die-face top">⚂</div>
          <div class="die-face bottom">⚃</div>
        </div>
      </div>
      <div id="s1-roll-panel">
        <button class="roll-btn" id="btn-roll1" onclick="s1RollOne()">🎲 Rzuć</button>
        <button class="roll-btn" id="btn-roll120" onclick="s1Roll120()">🎰 Rzuć 120×</button>
      </div>
      <div id="retries-msg"></div>
    </div>

  </div>
