<div id="nav">
  <h1>⚛️ Kwantowa Kostka</h1>
  <button class="tab-btn active" id="tab1" onclick="showScreen(1)">🎲 Ustaw kostkę</button>
  <button class="tab-btn" id="tab2" onclick="showScreen(2)">🔗 Splącz z kostką kolegi</button>
</div>

<!-- ═══════════════ SCREEN 1 ═══════════════ -->
<div id="screen1" class="screen active">
  <div id="s1-layout">

    <!-- LEFT: 3 Bloch spheres -->
    <div id="s1-spheres">
      <div class="bloch-wrap" id="bwrap-0">
        <div class="bloch-label">Kubit A (MSB)</div>
        <canvas class="bloch-canvas" id="bloch-0" width="110" height="110"></canvas>
        <div class="bloch-info" id="binfo-0">0: 100% | 1: 0% | faza: 0°</div>
        <button class="h-btn" onclick="applyH1(0)">H</button>
      </div>
      <div class="bloch-wrap" id="bwrap-1">
        <div class="bloch-label">Kubit B</div>
        <canvas class="bloch-canvas" id="bloch-1" width="110" height="110"></canvas>
        <div class="bloch-info" id="binfo-1">0: 100% | 1: 0% | faza: 0°</div>
        <button class="h-btn" onclick="applyH1(1)">H</button>
      </div>
      <div class="bloch-wrap" id="bwrap-2">
        <div class="bloch-label">Kubit C (LSB)</div>
        <canvas class="bloch-canvas" id="bloch-2" width="110" height="110"></canvas>
        <div class="bloch-info" id="binfo-2">0: 100% | 1: 0% | faza: 0°</div>
        <button class="h-btn" onclick="applyH1(2)">H</button>
      </div>
    </div>

    <!-- MID: cheat sheet + 2 histograms -->
    <div id="s1-mid">
      <div id="cheat-sheet">
        <h3>Ściąga: wynik → kubity A B C</h3>
        <table class="cs-table" id="cs-table">
          <tr><th>Ścianka</th><th>A</th><th>B</th><th>C</th></tr>
          <tr id="cs-1"><td>1</td><td>0</td><td>0</td><td>0</td></tr>
          <tr id="cs-2"><td>2</td><td>0</td><td>0</td><td>1</td></tr>
          <tr id="cs-3"><td>3</td><td>0</td><td>1</td><td>0</td></tr>
          <tr id="cs-4"><td>4</td><td>0</td><td>1</td><td>1</td></tr>
          <tr id="cs-5"><td>5</td><td>1</td><td>0</td><td>0</td></tr>
          <tr id="cs-6" style="font-weight:700"><td>6</td><td>1</td><td>0</td><td>1</td></tr>
          <tr id="cs-fell" class="cs-row-fell"><td>🗑 ze stołu</td><td colspan="3" style="text-align:center">1 1 0 · 1 1 1</td></tr>
        </table>
      </div>

      <div class="hist-panel">
        <h3>📐 Teoretyczny rozkład</h3>
        <canvas id="hist-theory" height="130"></canvas>
