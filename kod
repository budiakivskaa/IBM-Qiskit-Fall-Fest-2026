<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Kwantowa Kostka v2</title>
<style>
:root {
  --bg: #0d1117;
  --surface: #161b22;
  --surface2: #21262d;
  --border: #30363d;
  --text: #e6edf3;
  --muted: #8b949e;
  --accent: #58a6ff;
  --yellow: #d29922;
  --green: #3fb950;
  --purple: #bc8cff;
  --red: #f85149;
  --orange: #ffa657;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: -apple-system,"Segoe UI",system-ui,sans-serif; font-size: 14px; overflow-x: hidden; min-height: 100vh; }

/* NAV */
#nav { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--surface); border-bottom: 1px solid var(--border); flex-wrap: wrap; }
#nav h1 { font-size: 15px; font-weight: 700; color: var(--accent); flex: 1; min-width: 120px; }
.tab-btn { padding: 6px 14px; border-radius: 6px; border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; font-size: 13px; transition: .15s; }
.tab-btn.active { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 600; }

/* SCREENS */
.screen { display: none; padding: 12px 10px 80px; }
.screen.active { display: block; }

/* BLOCH SPHERE */
.bloch-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.bloch-label { font-size: 11px; color: var(--muted); font-weight: 600; }
.bloch-canvas { cursor: grab; border-radius: 50%; display: block; touch-action: none; }
.bloch-canvas:active { cursor: grabbing; }
.bloch-info { font-size: 10px; color: var(--accent); text-align: center; line-height: 1.5; min-height: 30px; }
.h-btn { padding: 3px 10px; border-radius: 5px; border: 1px solid var(--purple); background: transparent; color: var(--purple); cursor: pointer; font-size: 12px; font-weight: 700; transition: .15s; }
.h-btn:hover { background: rgba(188,140,255,.2); }
.h-btn:active { transform: scale(.93); }

/* SCREEN 1 LAYOUT */
#s1-layout { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: start; }
@media(max-width: 700px) { #s1-layout { grid-template-columns: 1fr; } }

#s1-spheres { display: flex; flex-direction: column; gap: 14px; }
#s1-mid { display: flex; flex-direction: column; gap: 12px; }
#s1-right { display: flex; flex-direction: column; gap: 12px; align-items: center; }

/* CHEAT SHEET */
#cheat-sheet { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px; }
#cheat-sheet h3 { font-size: 12px; color: var(--muted); margin-bottom: 7px; text-align: center; }
.cs-table { width: 100%; border-collapse: collapse; font-size: 11px; }
.cs-table th { color: var(--muted); font-weight: 600; padding: 2px 6px; text-align: center; }
.cs-table td { padding: 3px 6px; text-align: center; border-radius: 4px; transition: background .3s, color .3s; }
.cs-row-hl td { background: rgba(88,166,255,.18); color: var(--accent); font-weight: 700; }
.cs-row-fell td { color: var(--red); }

/* HISTOGRAMS */
.hist-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px; }
.hist-panel h3 { font-size: 12px; color: var(--muted); margin-bottom: 6px; text-align: center; }
.hist-panel canvas { width: 100%; display: block; }
.hist-sub { font-size: 10px; color: var(--muted); text-align: center; margin-top: 4px; min-height: 14px; }

/* ROLL PANEL */
#s1-roll-panel { display: flex; flex-direction: column; gap: 10px; align-items: center; }
.roll-btn { padding: 10px 18px; border-radius: 10px; border: none; cursor: pointer; font-size: 13px; font-weight: 700; width: 140px; transition: .12s; }
.roll-btn:active { transform: scale(.95); }
#btn-roll1 { background: var(--accent); color: #000; }
#btn-roll120 { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }

#die3d-wrap { perspective: 220px; width: 70px; height: 70px; }
#die3d { width: 70px; height: 70px; position: relative; transform-style: preserve-3d; transition: transform .6s cubic-bezier(.17,.67,.41,1.3); }
.die-face { position: absolute; width: 70px; height: 70px; border: 2px solid var(--border); border-radius: 8px; background: var(--surface2); display: flex; align-items: center; justify-content: center; font-size: 26px; }
.die-face.front  { transform: translateZ(35px); }
.die-face.back   { transform: translateZ(-35px) rotateY(180deg); }
.die-face.right  { transform: rotateY(90deg) translateZ(35px); }
.die-face.left   { transform: rotateY(-90deg) translateZ(35px); }
.die-face.top    { transform: rotateX(90deg) translateZ(35px); }
.die-face.bottom { transform: rotateX(-90deg) translateZ(35px); }

#roll-result { font-size: 48px; min-height: 60px; text-align: center; }
#roll-msg { font-size: 11px; color: var(--muted); text-align: center; min-height: 16px; }
#retries-msg { font-size: 11px; color: var(--orange); text-align: center; min-height: 16px; }

/* SCREEN 2 LAYOUT */
#s2-layout { display: flex; flex-direction: column; gap: 12px; }
#s2-dice-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: start; }
@media(max-width: 700px) { #s2-dice-row { grid-template-columns: 1fr; } }

.dice-box { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px; }
.dice-box h3 { font-size: 13px; font-weight: 700; margin-bottom: 8px; text-align: center; }
.dice-box-spheres { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

/* CNOT CABLES */
#cables-panel { display: flex; flex-direction: column; gap: 8px; align-items: center; padding: 8px 4px; }
#cables-panel h4 { font-size: 11px; color: var(--muted); text-align: center; }
.cable-row { display: flex; align-items: center; gap: 4px; }
.cable-line { height: 3px; width: 36px; border-radius: 2px; background: var(--border); transition: .3s; }
.cable-line.on { background: var(--green); }
.cable-btn { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--border); background: transparent; cursor: pointer; color: var(--muted); font-size: 13px; transition: .15s; }
.cable-btn.on { border-color: var(--green); color: var(--green); background: rgba(63,185,80,.12); }

#s2-hists { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.mini-hist { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 8px; }
.mini-hist h4 { font-size: 11px; color: var(--muted); margin-bottom: 4px; text-align: center; }

#s2-bottom { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: start; }
@media(max-width: 700px) { #s2-bottom { grid-template-columns: 1fr; } }

#joint-grid-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; display: flex; flex-direction: column; align-items: center; }
#joint-grid-panel h3 { font-size: 13px; color: var(--muted); margin-bottom: 10px; text-align: center; }
#joint-grid-wrap { width: min(calc(100vh - 260px), 100%); aspect-ratio: 1; }
#joint-grid { display: grid; grid-template-columns: auto repeat(6, 1fr); gap: 3px; width: 100%; height: 100%; }
.jg-cell { width: 100%; border-radius: 4px; background: var(--surface2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted); transition: .3s; }
.jg-header { font-size: 11px; font-weight: 600; color: var(--muted); text-align: center; display: flex; align-items: center; justify-content: center; }

#s2-roll-col { display: flex; flex-direction: column; gap: 8px; align-items: stretch; min-width: 140px; }
#s2-roll-col button { padding: 9px 14px; border-radius: 8px; border: none; cursor: pointer; font-size: 12px; font-weight: 600; white-space: nowrap; }
#btn-s2-rollx { background: var(--accent); color: #000; }
#btn-s2-rolly { background: var(--purple); color: #000; }
#btn-s2-rollxy { background: var(--green); color: #000; }
#btn-s2-roll120 { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }
#s2-result { font-size: 12px; color: var(--muted); text-align: center; min-height: 18px; }
#s2-retries { font-size: 11px; color: var(--orange); text-align: center; min-height: 14px; }

/* ADV MODE toggle */
#adv-toggle-wrap { text-align: center; }
#adv-toggle { padding: 5px 14px; border-radius: 6px; border: 1px solid var(--orange); background: transparent; color: var(--orange); cursor: pointer; font-size: 12px; }
#adv-toggle.on { background: rgba(255,166,87,.15); }
#adv-info { font-size: 11px; color: var(--muted); text-align: center; margin-top: 4px; min-height: 14px; }

/* TOAST */
#toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%) translateY(60px); background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 10px 18px; font-size: 13px; color: var(--text); opacity: 0; transition: .3s; z-index: 999; max-width: 300px; text-align: center; pointer-events: none; }
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>
</head>
