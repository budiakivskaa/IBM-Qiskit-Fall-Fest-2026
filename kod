      <div id="roll-result">🎲</div>
      <div id="roll-msg"></div>
      <div id="die3d-wrap">
        <div id="die3d">
          <div class="die-face front">⚀</div>
          <div class="die-face back">⚅</div>
          <div class="die-face right">⚁</div>
