          </div>
          <div class="bloch-wrap">
            <div class="bloch-label">C</div>
            <canvas class="bloch-canvas" id="bloch-y2" width="80" height="80"></canvas>
            <div class="bloch-info" id="binfo-y2" style="font-size:9px">0:100%|1:0%|φ:0°</div>
